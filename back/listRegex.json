{
    "_comment": [
        "--- All Regex are from these Source ---",
        "Deepseek & ChatGPT",
        "https://stackoverflow.com/a/27728417/29665155",
        "https://stackoverflow.com/a/77178079/29665155",
        "https://regex101.com/r/Mcd4kh/1",
        "https://github.com/Cyberghxst/Sora/blob/main/constants.json"
    ],
    "youtube": [
        "(?:[?&]v(?:i)?=|(?:^|/)(?:youtu\\.be|v|vi|u/\\w|embed|shorts|watch|live|source)/)([A-Za-z0-9_-]{11})(?=$|[?#&/])",
        1
    ],
    "youtubeplaylist": [
        "(?:^|[?&])list=([A-Za-z0-9_-]+)(?=$|[&#/])",
        1
    ],
    "soundcloud": [
        "(?:https?:\\/\\/)?(?:[a-z0-9-]+\\.)?(?:soundcloud\\.com|snd\\.sc)\\/((?:[A-Za-z0-9_-]+\\/(?:sets\\/[A-Za-z0-9_-]+|[A-Za-z0-9_-]+))|[A-Za-z0-9]+)(?=$|[?#])",
        1
    ],
    "spotify": [
        "^(?:https?:\\/\\/)?(?:open\\.spotify\\.com\\/|spotify:)((?:user|episode|playlist|track|album|artist)[\\/:][A-Za-z0-9]+)(?:\\?.*)?$",
        1
    ],
    "tiktok": [
        "^(?:https?:\\/\\/)?(?:(?:www\\.)?(?:m\\.)?tiktok\\.com\\/(?:(?:@[^\\/]*\\/video\\/)|v\\/)|t\\.tiktok\\.com\\/i18n\\/share\\/video\\/)(\\d{18,21})(?:\\.html)?(?:[\\/\\?#].*)?$",
        1
    ],
    "tiktokmob": [
        "^(?:https?:\\/\\/)?(?:vt|vm)\\.tiktok\\.com\\/([A-Za-z0-9-]+)\\/?$",
        1
    ],
    "tiktokmusic": [
        "tiktok\\.com\/music\/[^\/]*?(\\d{18,21})(?:$|[\/?])",
        1
    ],
    "facebook": [
        "^(?:https?:\\/\\/)?(?:www\\.|web\\.|m\\.)?facebook\\.com\\/([^?#]+)(?:[\\?#].*)?$",
        1
    ],
    "instagram": [
        "^(?:https?:\\/\\/)?(?:www\\.|m\\.)?instagram\\.com\\/((?:[^\\/?#]+\\/(?:p|reels?)\\/[A-Za-z0-9_-]+)|(?:(?:p|reels?)\\/[A-Za-z0-9_-]+))(?:[\\/?#].*)?$",
        1
    ],
    "instagramaudio": [
        "^(?:https?:\\/\\/)?(?:www\\.|m\\.)?instagram\\.com\\/reels\\/audio\\/([A-Za-z0-9_-]+)(?:[\\/?#].*)?$",
        1
    ],
    "bandcamp": [
        "^((?:https?:\\/\\/)?(?:[A-Za-z0-9-]+\\.)+bandcamp\\.com\\/track\\/[^\\/?#]+(?:[\\/?#].*)?)$",
        1
    ],
    "twitter": [
        "^(?:https?:\\/\\/)?(?:[A-Za-z0-9-]+\\.)?(?:x\\.com|twitter\\.com)\\/(?:(?:i\\/web\\/status)|(?:[^\\/]+\\/status))\\/(\\d{5,25})(?:\\/[^\\?#]*)?(?:[\\?#].*)?$",
        1
    ]
}